# KIS Developers Open API 인증 정보
# 실제 값은 이 파일을 복사해서 .env 로 만든 뒤 채워넣으세요. (.env는 git에 커밋되지 않습니다)

KIS_APP_KEY=your_app_key_here
KIS_APP_SECRET=your_app_secret_here
KIS_ACCOUNT_NO=your_account_number_here

# vps = 모의투자(openapivts.koreainvestment.com:29443), prod = 실전투자(openapi.koreainvestment.com:9443)
KIS_TRADING_MODE=vps

# 수집 실패 시 Discord 알림을 받고 싶다면 채널 웹훅 URL 입력 (선택사항).
DISCORD_WEBHOOK_URL=

# AI 일일 채점/월간 분석용 Anthropic API 키 (console.anthropic.com에서 발급, 선택사항).
# 미설정 시 AI 리포트만 조용히 생략되고 나머지는 정상 동작.
ANTHROPIC_API_KEY=

# ---- 자동매매 파라미터 (run_trader.py) ----

# 돌파 계수 (백테스트 기준 0.8 권장)
TRADE_K=0.8
# 동시 보유 최대 종목 수
MAX_POSITIONS=5
# 종목당 투입 금액(원)
TRADE_BUDGET_KRW=1000000
# 지수 타이밍 전략(KODEX 200 절대 모멘텀)에 배분할 금액(원). 0이면 비활성.
# 백테스트 기준 돌파 전략과 균등 배분 권장 (예: 돌파 최대 500만이면 여기도 5000000)
ETF_BUDGET_KRW=0
# 저변동성 우량주(월간 리밸런싱, 방어형)에 배분할 총액(원). 0이면 비활성.
# LOWVOL_TOP_N 종목에 균등 분할 (예: 5000000 / 10종목 = 종목당 50만원)
LOWVOL_BUDGET_KRW=0
LOWVOL_TOP_N=10
# 실전투자(prod) 모드에서 주문을 허용하려면 true로 명시 (기본: 모의투자만 허용)
ALLOW_PROD_TRADING=false

# ---- 미국 전략 (run_us_trader.py, 미장 스케줄로 별도 실행) ----
# 검증 완료: ① 지수타이밍, ② 돌파+시장필터. 예산=0이면 신호 통보만 하는 드라이런.
# 실돈 전환 전 KIS_TRADING_MODE=vps(모의)로 먼저 검증할 것.
# ① SPY 200일선 타이밍에 배분할 금액($). SPY 1주(~$550) 이상 필요. 0이면 비활성.
US_INDEX_BUDGET_USD=0
US_INDEX_SYMBOL=SPY
# ② 신고가 돌파+시장필터에 배분할 총액($). 슬롯 수로 나눠 종목당 예산. 0이면 비활성.
US_BREAKOUT_BUDGET_USD=0
US_BREAKOUT_MAX_POSITIONS=5
# 해외 지정가 즉시체결용 가격 버퍼(현재가 대비, 0.01=1%). 매수 +버퍼, 매도 -버퍼.
US_ORDER_SLIPPAGE=0.01

# ---- 안전장치 (kill-switch, 리스크 관리) ----
# 코스피(KODEX200 대용) 당일 등락률이 이 값(%) 이하로 급락하면 그날 신규 진입 중단.
CRASH_HALT_PCT=-4.0
# 실현 누적손익이 이 금액(원) 이상 손실이면 신규 진입 중단 + 알림. 0이면 비활성.
# 예: 자본 1000만원 기준 -15%면 1500000
LOSS_LIMIT_KRW=0
